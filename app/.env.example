# Número do WhatsApp do suporte, só dígitos com DDI (ex.: 5511999999999). Vazio = item Suporte não aparece.
VITE_SUPPORT_WHATSAPP=

# Supabase (opcional: o app já usa o projeto do Grupo RME por padrão).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Checkout da Payt do Reset Emocional do Ex (upsell #01). Vazio = o app não mostra botão de compra.
VITE_RESET_CHECKOUT_URL=
