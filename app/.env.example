# Número do WhatsApp do suporte, só dígitos com DDI (ex.: 5511999999999). Vazio = item Suporte não aparece.
VITE_SUPPORT_WHATSAPP=

# Supabase (opcional: o app já usa o projeto do Grupo RME por padrão).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Reset Emocional do Ex: oferta ANTIGA, mantida só para quem já comprou (não é uma das ofertas atuais).
# Checkout usado só na tela bloqueada do Reset. Vazio = o app não mostra botão de compra.
VITE_RESET_CHECKOUT_URL=

# ---- Ofertas atuais (Meus Benefícios). Ver docs/estrutura-comercial-upsells.md ----
# Nenhum destes valores libera acesso: a liberação vem só das compras (cr_my_entitlements).
# Vazio = o botão correspondente não aparece.

# Upsell 01 · Conselheiro da Reconquista: WhatsApp oficial do atendimento (só dígitos com DDI).
VITE_CONSELHEIRO_WHATSAPP=
# Horários e condições do atendimento, em texto (aparece só para quem tem o benefício liberado).
VITE_CONSELHEIRO_HORARIOS=
# Checkout da oferta (https). Aparece como "Conhecer a oferta" para quem não tem o benefício.
VITE_CONSELHEIRO_CHECKOUT_URL=

# Upsell 02 · Círculo da Reconquista: link de entrada da comunidade (https). Fica visível no código do
# app: usar um link que exija aprovação na entrada, nunca um convite aberto.
VITE_CIRCULO_URL=
VITE_CIRCULO_CHECKOUT_URL=

# Upsell 03 · Código da Reconquista: Acesso Total Vitalício.
VITE_VITALICIO_CHECKOUT_URL=
